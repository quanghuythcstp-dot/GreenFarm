# Copy file này thành config.properties và điền thông tin thực tế
# KHÔNG commit file config.properties lên Git

# Google OAuth 2.0
google.client.id=YOUR_GOOGLE_CLIENT_ID
google.client.secret=YOUR_GOOGLE_CLIENT_SECRET
google.redirect.uri=http://localhost:8080/GreenFarm/auth/google/callback

